# ---- Supabase (required) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Used by the payment webhook, admin page and API-key endpoint.
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated emails allowed to open /admin and activate plans manually.
ADMIN_EMAILS=

# ---- AI (Gemini) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ---- Payments (Selar) ----
NEXT_PUBLIC_SELAR_STARTER_URL=https://selar.com/47plan?currency=USD
NEXT_PUBLIC_SELAR_GROWTH_URL=https://selar.com/57plan?currency=USD
NEXT_PUBLIC_SELAR_SCALE_URL=https://selar.com/97plan?currency=USD
# Shared secret that must accompany webhook calls to /api/webhooks/selar
# (header x-webhook-secret, or ?token=). Generate a long random string.
SELAR_WEBHOOK_SECRET=

# Public support address shown on the About page (optional)
NEXT_PUBLIC_SUPPORT_EMAIL=
